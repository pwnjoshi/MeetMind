<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>MeetMind</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    
    <!-- Privacy Descriptions -->
    <key>NSMicrophoneUsageDescription</key>
    <string>MeetMind requires microphone access to record audio during meetings and live conversations.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>MeetMind requires speech recognition access to transcribe spoken dialogue into real-time text.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>MeetMind accesses your calendar to import scheduled meetings and save meeting reminders.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>MeetMind accesses your calendar to import scheduled meetings and save meeting reminders.</string>
    <key>NSRemindersUsageDescription</key>
    <string>MeetMind accesses reminders to export extracted meeting action items into Apple Reminders.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>MeetMind accesses reminders to export extracted meeting action items into Apple Reminders.</string>
    <key>NSCameraUsageDescription</key>
    <string>MeetMind requires camera access to capture photos of whiteboards and presentations during meetings.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>MeetMind allows attaching photos from your photo library to meeting notes.</string>
    
    <!-- Background Audio Mode -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    
    <!-- Custom URL Schemes for Deep Linking -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.meetmind.app</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>meetmind</string>
            </array>
        </dict>
    </array>
    
    <!-- Scene Manifest -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict/>
    </dict>
    
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
